---
import Base from '../layouts/Base.astro';
import TechList from '../components/TechList.astro';
import { site, toolkit } from '../data/site';
import { projects } from '../data/projects';

const featured = projects.find((p) => p.featured)!;
const others = projects.filter((p) => !p.featured);

// Totals from CONTRIBUTIONS_AUDIT.md (merged PRs I authored, non-merge commits under my emails).
const totals = [
  { value: '4', label: 'team projects' },
  { value: '83', label: 'merged PRs' },
  { value: '425', label: 'commits' },
];
const focus = ['Payments & idempotency', 'Message queues & workers', 'Caching with Redis', 'CI/CD & Docker'];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Open to internships & junior roles · {site.location}</span>
        <h1>Hi, I’m {site.name}.<br /><span class="accent">I build backends that hold up.</span></h1>
        <p class="lead">{site.tagline}</p>
        <div class="btn-row">
          <a class="btn primary" href={`/projects/${featured.slug}/`}>Read the Ticket_Box case study →</a>
          <a class="btn" href={`mailto:${site.email}`}>Email me</a>
          <a class="btn" href={site.github}>GitHub</a>
        </div>
      </div>

      <aside class="profile card" aria-label="At a glance">
        <div class="profile-top">
          <span class="avatar" aria-hidden="true">TQV</span>
          <div>
            <strong>{site.nativeName}</strong>
            <span class="muted small">Final-year · HCMUS</span>
          </div>
        </div>
        <div class="totals">
          {totals.map((t) => (
            <div><span class="stat-value">{t.value}</span><span class="stat-label">{t.label}</span></div>
          ))}
        </div>
        <p class="small muted label">What I focus on</p>
        <ul class="focus">{focus.map((f) => <li>{f}</li>)}</ul>
        <p class="small muted label">Daily drivers</p>
        <TechList items={['NestJS', 'PostgreSQL', 'Redis', 'RabbitMQ', 'Docker']} />
      </aside>
    </div>
    <div class="wrap">
      <p class="honesty muted">
        Every project here is team coursework. Each page separates <strong>what I built</strong> from what teammates
        built, and links to merged pull requests as evidence.
      </p>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <span class="eyebrow">Selected work</span>
      <h2>Featured project</h2>

      <a class="card featured" href={`/projects/${featured.slug}/`}>
        <div class="featured-body">
          <div>
            <p class="muted role">{featured.role} · {featured.team} · {featured.period}</p>
            <h3>{featured.name}</h3>
            <p>{featured.summary}</p>
            <ul class="highlights">
              {featured.contributions.map((c) => <li>{c.title}</li>)}
            </ul>
            <TechList items={featured.stack} />
          </div>
          <div class="featured-side">
            {featured.stats.map((s) => (
              <div class="side-stat"><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></div>
            ))}
            <span class="read">Read case study →</span>
          </div>
        </div>
      </a>

      <h2 class="more-title">More projects</h2>
      <div class="grid cols-3">
        {others.map((p) => (
          <a class="card project" href={`/projects/${p.slug}/`}>
            <p class="muted role">{p.role}</p>
            <h3>{p.name}</h3>
            <p class="summary">{p.summary}</p>
            <TechList items={p.stack.slice(0, 4)} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="toolkit">
    <div class="wrap">
      <span class="eyebrow">Toolkit</span>
      <h2>What I reach for</h2>
      <p class="muted">Solid tiles are what I used most in the projects above. Dashed tiles are tools I have used, but less.</p>
      <div class="toolkit">
        {toolkit.map((g) => (
          <div class="card group">
            <h3>{g.group}</h3>
            <TechList items={g.core} variant="tile" />
            <TechList items={g.also} variant="tile" muted />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="card contact">
        <div>
          <span class="eyebrow">Contact</span>
          <h2>Let’s talk</h2>
          <p class="muted">I’m looking for backend or fullstack internship and junior roles. Email is the fastest way to reach me.</p>
        </div>
        <div class="btn-row">
          <a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn" href={site.github}>github.com/{site.githubHandle}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 80px 0 40px; position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 30%, transparent 75%);
  }
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.35fr 1fr; } }
  .accent { color: var(--accent); }
  .dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px;
    background: #22c55e; box-shadow: 0 0 0 3px color-mix(in srgb, #22c55e 25%, transparent);
  }
  .lead { font-size: 1.12rem; max-width: 40rem; margin-bottom: 1.6rem; color: var(--muted); }
  .honesty { font-size: 0.9rem; margin: 36px 0 0; max-width: 46rem; }

  .profile { box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.25); }
  .profile-top { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .profile-top strong, .profile-top .small { display: block; }
  .avatar {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px;
    background: var(--accent); color: var(--bg); font: 600 0.8rem var(--mono);
  }
  .totals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 14px 0; border-block: 1px solid var(--line); margin-bottom: 14px; }
  .small { font-size: 0.85rem; }
  .label { margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; }
  .focus { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 4px; font-size: 0.92rem; }
  .focus li::before { content: '▸ '; color: var(--accent); }

  .featured { display: block; text-decoration: none; padding: 0; overflow: hidden; transition: border-color 0.15s, transform 0.15s; }
  .featured:hover, .project:hover { border-color: var(--accent); color: inherit; transform: translateY(-2px); }
  .featured-body { display: grid; }
  .featured-body > div:first-child { padding: 28px; }
  @media (min-width: 860px) { .featured-body { grid-template-columns: 1fr 220px; } }
  .featured-side {
    background: var(--accent-soft); padding: 28px; display: flex; flex-direction: column; gap: 18px;
  }
  .side-stat .stat-value { font-size: 2rem; }
  .read { margin-top: auto; font-weight: 600; color: var(--accent); }
  .featured h3 { font-size: 1.7rem; margin-bottom: 0.4em; }
  .role { font-size: 0.85rem; margin-bottom: 0.6em; }
  .highlights { list-style: none; padding: 0; margin: 0 0 1.2rem; display: grid; gap: 6px; }
  .highlights li::before { content: '✓'; color: var(--accent); font-weight: 700; margin-right: 10px; }

  .more-title { margin-top: 56px; }
  .project { text-decoration: none; display: flex; flex-direction: column; transition: border-color 0.15s, transform 0.15s; }
  .project .summary { flex: 1; }

  .toolkit { display: grid; gap: 18px; }
  @media (min-width: 860px) { .toolkit { grid-template-columns: repeat(2, 1fr); } }
  .group { display: flex; flex-direction: column; gap: 12px; }
  .group h3 { margin: 0; }

  #contact { border-top: 0; padding-top: 24px; }
  .contact { display: grid; gap: 20px; padding: 32px; background: var(--accent-soft); border-color: transparent; }
  @media (min-width: 860px) { .contact { grid-template-columns: 1fr auto; align-items: end; } }
  .contact h2 { margin-bottom: 0.3em; }
  .contact p { margin: 0; }
</style>
